DATABASE_URL=postgresql://localhost:5432/archaeologist

# Answers. With nothing set, answers are evidence briefings (no model, free).
# Free tier with written answers + agent mode: a Google AI Studio key
# (https://aistudio.google.com/apikey). Free-tier prompts may be used by Google.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Free local model: install Ollama, run `ollama pull qwen2.5-coder:7b`, keep it running.
# OLLAMA_MODEL=qwen2.5-coder:7b
# Paid, strongest answers: an Anthropic API key (console.anthropic.com).
ANTHROPIC_API_KEY=
# ANSWER_PROVIDER=auto   # auto | gemini | anthropic | ollama | briefing
# ANSWER_MODEL=claude-opus-5
# ANSWER_EFFORT=medium

# Optional: private repos, and 5,000 instead of 60 GitHub API requests/hour.
GITHUB_TOKEN=

# Accounts
# ALLOW_SIGNUP=true
# COOKIE_SECURE=false    # true when served over HTTPS
