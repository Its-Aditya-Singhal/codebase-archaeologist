DATABASE_URL=postgresql://localhost:5432/archaeologist

# Answers. With nothing set, answers are evidence briefings (no model, free).
# Free local model: install Ollama, run `ollama pull qwen2.5-coder:7b`, keep it running.
# OLLAMA_MODEL=qwen2.5-coder:7b
# Paid, strongest answers: an Anthropic API key (console.anthropic.com).
ANTHROPIC_API_KEY=
# ANSWER_PROVIDER=auto   # auto | anthropic | ollama | briefing
# ANSWER_MODEL=claude-opus-5
# ANSWER_EFFORT=medium

# Optional: private repos, and 5,000 instead of 60 GitHub API requests/hour.
GITHUB_TOKEN=
